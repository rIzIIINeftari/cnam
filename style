@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap');
:root{font-family:'DM Sans',sans-serif;color:#202d28;background:#f2f0e8;font-synthesis:none}*{box-sizing:border-box}body{margin:0}.club{max-width:1080px;margin:auto;padding:60px 28px 24px}header{margin-bottom:40px}.eyebrow{font-size:11px;letter-spacing:2px;font-weight:700;color:#627169}h1,h2{font-family:'Space Grotesk',sans-serif}h1{font-size:clamp(42px,7vw,72px);letter-spacing:-4px;margin:12px 0}h1 span{color:#638676}header p{color:#627169;font-size:17px}.game{display:grid;grid-template-columns:340px 1fr;border:1px solid #d4d9cf;border-radius:24px;overflow:hidden;background:#fbfaf5;box-shadow:0 18px 60px #223c2510}.settings{padding:32px;background:#e6ebdf}.settings h2{font-size:28px;margin:18px 0 30px}label{display:block;font-size:13px;font-weight:700;margin:20px 0 9px}select{width:100%;padding:13px 12px;border:1px solid #c6cebf;border-radius:9px;background:#f8faf2;color:#26382c;font:inherit;font-size:14px}.hint{font-size:14px;line-height:1.7;min-height:72px;color:#53634f;margin:24px 0}.primary{display:flex;justify-content:space-between;width:100%;padding:16px;border:0;border-radius:10px;background:#234a37;color:white;font:inherit;font-weight:600;cursor:pointer}.primary:hover{background:#32694d}.small{font-size:11px;line-height:1.6;color:#65705e}.arena{padding:32px 45px;text-align:center}.arena-top{display:flex;justify-content:space-between;align-items:center;gap:12px}.badge{font-size:9px;letter-spacing:1px;border:1px solid #d8ddd2;border-radius:20px;padding:7px 10px;color:#61705e}.arena h2{font-size:22px;margin:30px 0 24px;min-height:30px}.board{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;max-width:350px;margin:auto}.cell{aspect-ratio:1;border:1px solid #dbdfd4;border-radius:16px;background:#f0f2e9;font-family:'Space Grotesk',sans-serif;font-size:clamp(34px,6vw,60px);font-weight:600;cursor:pointer;color:#244c38;transition:background .15s,transform .15s}.cell:not(:disabled):hover{background:#e1e7d7;transform:translateY(-2px)}.cell.o{color:#b07443}.cell:disabled{cursor:default;opacity:1}.cell.win{background:#d0e2ba;border-color:#87a568}.rule{font-size:12px;color:#76816f;margin-top:24px}footer{text-align:center;color:#76816f;font-size:12px;margin:26px}button:focus-visible,select:focus-visible{outline:3px solid #a66b38;outline-offset:3px}[hidden]{display:none!important}@media(max-width:720px){.club{padding:30px 16px}header{margin-bottom:26px}h1{letter-spacing:-2px}.game{grid-template-columns:1fr}.settings{padding:24px}.settings h2{margin:12px 0 18px}.hint{min-height:0;margin:18px 0}.arena{padding:24px 20px}.cell{font-size:48px}.arena-top{flex-wrap:wrap}}
