/* Moteur indépendant de l'interface, également utilisé par les simulations. */
(function (root) {
  'use strict';
  const lines = [[0,1,2],[3,4,5],[6,7,8],[0,3,6],[1,4,7],[2,5,8],[0,4,8],[2,4,6]];
  const other = player => player === 'X' ? 'O' : 'X';
  const empty = board => board.map((v, i) => v === '' ? i : -1).filter(i => i !== -1);
  function result(board) {
    for (const line of lines) {
      if (board[line[0]] && line.every(i => board[i] === board[line[0]])) {
        return { winner: board[line[0]], line };
      }
    }
    return empty(board).length ? null : { winner: 'draw', line: [] };
  }
  function minimax(board, turn, ai, depth) {
    const end = result(board);
    if (end) return end.winner === ai ? 10 - depth : end.winner === 'draw' ? 0 : depth - 10;
    const scores = empty(board).map(i => {
      board[i] = turn;
      const score = minimax(board, other(turn), ai, depth + 1);
      board[i] = '';
      return score;
    });
    return turn === ai ? Math.max(...scores) : Math.min(...scores);
  }
  function chooseMove(board, player, difficulty, random = Math.random) {
    if (result(board)) return null;
    const available = empty(board);
    const randomMove = () => available[Math.floor(random() * available.length)];
    if (difficulty === 'easy') return randomMove();
    if (difficulty === 'medium') {
      for (const target of [player, other(player)]) {
        for (const i of available) {
          board[i] = target;
          const end = result(board);
          board[i] = '';
          if (end && end.winner === target) return i;
        }
      }
      return randomMove();
    }
    let best = -Infinity;
    let move = available[0];
    for (const i of available) {
      board[i] = player;
      const score = minimax(board, other(player), player, 0);
      board[i] = '';
      if (score > best) { best = score; move = i; }
    }
    return move;
  }
  root.Morpion = { result, chooseMove, other, empty };
})(globalThis);
